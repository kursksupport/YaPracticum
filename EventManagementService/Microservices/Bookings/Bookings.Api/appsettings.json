{
  "ConnectionStrings": {
    "BookingsDb": "Host=localhost;Port=5432;Database=bookingsdb;Username=postgres;Password=postgres"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "ServiceName": "bookings-service",
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Jwt": {
    "Secret": "your-super-secret-key-for-jwt-token",
    "Issuer": "EventManagementService",
    "Audience": "EventManagementService"
  }
}
