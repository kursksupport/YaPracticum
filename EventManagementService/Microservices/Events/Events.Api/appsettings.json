{
  "ConnectionStrings": {
    "EventsDb": "Host=localhost;Port=5432;Database=eventsdb;Username=postgres;Password=postgres"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Cache": {
    "EventTtlMinutes": 10,
    "TopEventsTtlMinutes": 5
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "events-service"
  },
  "ServiceName": "events-service",
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Jwt": {
    "Secret": "your-super-secret-key-for-jwt-token",
    "Issuer": "EventManagementService",
    "Audience": "EventManagementService"
  }
}
